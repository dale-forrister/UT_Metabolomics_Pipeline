                    <parameter name="Size penalty">0.3</parameter>
                    <parameter name="RT spread threshold (min)">0.05</parameter>
                    <parameter name="Message-passing rounds">3</parameter>
                    <parameter name="Message-passing damping">0.5</parameter>
                    <parameter name="Split on annotation conflict">true</parameter>
                </module>
            </parameter>
            <parameter name="Representative row" selected_item="prefer_annotated">
                <module name="prefer_annotated"/>
                <module name="ion_type_ranking"/>
            </parameter>
        </parameter>
    </batchstep>
